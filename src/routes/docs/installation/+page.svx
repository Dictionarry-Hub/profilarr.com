			{row.description}
			{#if row.seeAlso}See <a href={row.seeAlso.href}>{row.seeAlso.label}</a>.{/if}
		{/if}
	{/snippet}
	{#snippet card(row)}
		<div class="flex flex-col gap-1">
			<div class="flex flex-wrap items-center gap-2">
